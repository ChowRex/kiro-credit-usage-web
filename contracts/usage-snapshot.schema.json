{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://internal.example/kiro/usage-snapshot.schema.json",
  "title": "Kiro usage snapshot",
  "description": "Public schema-v1 format. Cross-field totals, tier capacities, costs, percentages, and statuses are verified by app.storage.validate_snapshot.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "month",
    "data_cutoff",
    "no_month_data",
    "roster_source",
    "source_lag_warning",
    "usage_interpretation",
    "summary",
    "collection",
    "users"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "generated_at": {"type": "string", "format": "date-time"},
    "month": {"type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"},
    "data_cutoff": {
      "anyOf": [
        {"type": "string", "format": "date"},
        {"type": "null"}
      ]
    },
    "no_month_data": {"type": "boolean"},
    "roster_source": {
      "type": "string",
      "enum": ["authoritative_subscription_csv", "iam_identity_center"]
    },
    "source_lag_warning": {"type": "string", "minLength": 1},
    "usage_interpretation": {"type": "string", "minLength": 1},
    "content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "users",
        "zero",
        "low",
        "medium",
        "normal",
        "high",
        "unknown",
        "total_credits",
        "known_monthly_cost_usd",
        "unknown_cost_users"
      ],
      "properties": {
        "users": {"type": "integer", "minimum": 0},
        "zero": {"type": "integer", "minimum": 0},
        "low": {"type": "integer", "minimum": 0},
        "medium": {"type": "integer", "minimum": 0},
        "normal": {"type": "integer", "minimum": 0},
        "high": {"type": "integer", "minimum": 0},
        "unknown": {"type": "integer", "minimum": 0},
        "total_credits": {"type": "number", "minimum": 0},
        "known_monthly_cost_usd": {"type": "number", "minimum": 0},
        "unknown_cost_users": {"type": "integer", "minimum": 0}
      }
    },
    "collection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "query_count",
        "data_scanned_bytes",
        "engine_execution_ms",
        "total_execution_ms"
      ],
      "properties": {
        "query_count": {"type": "integer", "minimum": 0},
        "data_scanned_bytes": {"type": "integer", "minimum": 0},
        "engine_execution_ms": {"type": "integer", "minimum": 0},
        "total_execution_ms": {"type": "integer", "minimum": 0}
      }
    },
    "users": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "user_id",
          "user_name",
          "email",
          "tier",
          "credits",
          "overage",
          "capacity",
          "usage_percent",
          "first_active",
          "last_active",
          "active_days",
          "status",
          "monthly_cost_usd",
          "tier_source"
        ],
        "properties": {
          "user_id": {"type": "string", "minLength": 1},
          "user_name": {"type": "string"},
          "email": {"type": "string"},
          "tier": {
            "type": "string",
            "enum": ["Unknown", "Pro", "Pro+", "Pro Max", "Power"]
          },
          "credits": {"type": "number", "minimum": 0},
          "overage": {"type": "number", "minimum": 0},
          "capacity": {"type": "integer", "minimum": 0},
          "usage_percent": {
            "anyOf": [
              {"type": "number", "minimum": 0},
              {"type": "null"}
            ]
          },
          "first_active": {
            "anyOf": [
              {"type": "string", "format": "date"},
              {"const": ""}
            ]
          },
          "last_active": {
            "anyOf": [
              {"type": "string", "format": "date"},
              {"const": ""}
            ]
          },
          "active_days": {"type": "integer", "minimum": 0},
          "status": {
            "type": "string",
            "enum": ["zero", "low", "medium", "normal", "high", "unknown"]
          },
          "monthly_cost_usd": {
            "anyOf": [
              {"type": "number", "minimum": 0},
              {"type": "null"}
            ]
          },
          "tier_source": {
            "type": "string",
            "enum": [
              "current_authoritative_snapshot",
              "current_iic_group",
              "latest_at_data_cutoff",
              "unknown_direct_assignment"
            ]
          }
        }
      }
    }
  }
}
