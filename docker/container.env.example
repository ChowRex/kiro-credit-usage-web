# Copy this file outside the repository, for example:
#   cp docker/container.env.example /etc/kiro-credit-usage/container.env
# Replace every path with an absolute path on the Docker daemon host.
# Do not commit the resulting file.

# The service account that owns every mounted runtime path.
# KIRO_UID/KIRO_GID must match the numeric ownership seen by a standard rootful Docker daemon.
# Rootless Docker and userns-remap require a separate UID-mapping verification before use.
KIRO_UID=1000
KIRO_GID=1000

# Runtime files and directories. Create KIRO_DATA_DIR before startup and make it writable by KIRO_UID.
# KIRO_CONFIG_FILE must retain storage.data_dir = "data" (or set it to /app/data) for this Compose layout.
# KIRO_ADMIN_TOKEN_FILE must be owned by KIRO_UID and have mode 0600 or stricter.
# KIRO_AWS_DIR is a read-only standard AWS profile directory; do not put credentials in this file.
KIRO_CONFIG_FILE=/srv/kiro-credit-usage/config.local.toml
KIRO_DATA_DIR=/srv/kiro-credit-usage/data
KIRO_AWS_DIR=/srv/kiro-credit-usage/aws-profile
KIRO_ADMIN_TOKEN_FILE=/srv/kiro-credit-usage/.admin-token

# China mainland defaults for Debian package downloads. Overseas deployments may override both values
# with https://deb.debian.org/debian and https://deb.debian.org/debian-security.
DEBIAN_MIRROR=https://mirrors.tuna.tsinghua.edu.cn/debian
DEBIAN_SECURITY_MIRROR=https://mirrors.tuna.tsinghua.edu.cn/debian-security

# Docker Hub image tag and direct intranet HTTP port. Use a published version such as 0.1.1 on servers.
KIRO_IMAGE_TAG=0.1.1
KIRO_HTTP_PORT=8080
